{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Requirement",
  "type": "object",
  "required": ["requirement_id", "document_id", "document_sha256", "source_line_start", "source_line_end", "source_quote", "required_for_release", "support_status"],
  "properties": {
    "requirement_id": {"type": "string", "description": "条款编号，仅用于追溯"},
    "document_id": {"type": "string"},
    "document_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_line_start": {"type": "integer", "minimum": 1},
    "source_line_end": {"type": "integer", "minimum": 1},
    "source_quote": {"type": "string", "description": "必须与指定行范围的内容逐字一致"},
    "description": {"type": "string"},
    "interpretation": {
      "type": "string",
      "description": "对本条的解释约定；凡机器无法从字面推出的语义必须写在这里，并注明批准人"
    },
    "scope": {"type": "string"},
    "severity": {"type": "string", "enum": ["blocker", "major", "minor", "info"]},
    "required_for_release": {"type": "boolean", "description": "放行必检级别的权威值（GA-02）"},
    "support_status": {"type": "string", "enum": ["SUPPORTED", "NEEDS_CLARIFICATION", "UNSUPPORTED"]},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "ambiguities": {"type": "array", "items": {"type": "string"}}
  }
}
