# Never commit credentials. Copy to .env only if your launcher loads it explicitly.
# This application reads process environment, not .env automatically.
GA_BASE_URL=https://YOUR-PROVIDER.example/v1
GA_MODEL=YOUR-MODEL
GA_API_KEY=
# Actual provider prices per million tokens; required for live budget reservation.
GA_INPUT_USD_PER_MILLION=
GA_OUTPUT_USD_PER_MILLION=
GA_TIMEOUT_SECONDS=45
GA_MAX_CALLS=2
GA_MAX_OUTPUT_TOKENS=3500
GA_MAX_INPUT_CHARS=50000
GA_JOB_BUDGET_USD=0.10

# DeepSeek alternative: use GA_PROVIDER=deepseek and DEEPSEEK_API_KEY.
# See docs/DEEPSEEK.md or start-deepseek.cmd. CNY uses generic price variables:
# GA_CURRENCY=CNY
# GA_INPUT_PRICE_PER_MILLION=2
# GA_OUTPUT_PRICE_PER_MILLION=8
# GA_JOB_BUDGET=0.50
# GA_THINKING=disabled

# Qwen Beijing alternative: GA_PROVIDER=qwen and DASHSCOPE_API_KEY.
# The session-only launcher is start-qwen.cmd; see docs/QWEN.md.
