  "requirements": [
    {
      "requirement_id": "A1",
      "source_line_start": 7,
      "source_line_end": 7,
      "source_quote": "A1. 每条记录必须包含全部必填字段。",
      "description": "每条记录必须包含全部必填字段",
      "required_for_release": true,
      "support_status": "SUPPORTED",
      "ambiguities": [],
      "document_id": "delivery_spec.md",
      "document_sha256": "93a778c0316d46e0cc9f2c53dee435d9ddcb826bacbfce0d4550ab8f9134cb22"
    },
    {
      "requirement_id": "A2",
      "source_line_start": 8,
      "source_line_end": 8,
      "source_quote": "A2. 必填字段不得为空值；空值指去除首尾空白后长度为 0 的字符串。",
      "description": "必填字段不得为空值；空值指去除首尾空白后长度为 0 的字符串",
      "required_for_release": true,
      "support_status": "SUPPORTED",
      "ambiguities": [],
      "document_id": "delivery_spec.md",
      "document_sha256": "93a778c0316d46e0cc9f2c53dee435d9ddcb826bacbfce0d4550ab8f9134cb22"
    },
    {
      "requirement_id": "A3",
      "source_line_start": 9,
      "source_line_end": 9,
      "source_quote": "A3. 字段类型必须符合数据字典声明；日期时间字段采用 ISO8601 格式。",
      "description": "字段类型必须符合数据字典声明；日期时间字段采用 ISO8601 格式",
      "required_for_release": true,
      "support_status": "SUPPORTED",
      "ambiguities": [],
      "document_id": "delivery_spec.md",
      "document_sha256": "93a778c0316d46e0cc9f2c53dee435d9ddcb826bacbfce0d4550ab8f9134cb22"
    },
    {
      "requirement_id": "A4",
      "source_line_start": 10,
      "source_line_end": 10,
      "source_quote": "A4. category 字段取值必须在数据字典给定的枚举范围内。",
      "description": "category 字段取值必须在数据字典给定的枚举范围内",
      "required_for_release": true,
      "support_status": "SUPPORTED",
      "ambiguities": [],
      "document_id": "delivery_spec.md",
      "document_sha256": "93a778c0316d46e0cc9f2c53dee435d9ddcb826bacbfce0d4550ab8f9134cb22"
    },
    {
      "requirement_id": "A5",
      "source_line_start": 11,
      "source_line_end": 11,
      "source_quote": "A5. record_id 必须唯一，不得重复，也不得为空。",
      "description": "record_id 必须唯一，不得重复，也不得为空",
      "required_for_release": true,
      "support_status": "SUPPORTED",
      "ambiguities": [],
      "document_id": "delivery_spec.md",
      "document_sha256": "93a778c0316d46e0cc9f2c53dee435d9ddcb826bacbfce0d4550ab8f9134cb22"
    },
    {
      "requirement_id": "B1",
      "source_line_start": 15,
      "source_line_end": 15,
      "source_quote": "B1. 坐标必须是有限数值；经度取值范围 [-180,180]，纬度取值范围 [-90,90]。",
      "description": "坐标必须是有限数值；经度取值范围 [-180,180]，纬度取值范围 [-90,90]",
      "required_for_release": true,
      "support_status": "SUPPORTED",
      "ambiguities": [],
      "document_id": "delivery_spec.md",
